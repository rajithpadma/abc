# OpenRouter API Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.3-chat
MODEL_PRIORITY=anthropic/claude-sonnet-4.6,openai/gpt-5.3-chat,google/gemini-3-flash-preview
DEFAULT_MODEL=anthropic/claude-sonnet-4.6

# MongoDB Configuration
MONGODB_URI=
DATABASE_NAME=Product_Database

# Flask Configuration
FLASK_SECRET_KEY=
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Vision Model Path (set to src/vision/model or Render disk path)
VISION_MODEL_PATH=

# Excel Export Directory
EXPORT_PATH=exports
