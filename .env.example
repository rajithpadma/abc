# OpenRouter API Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.3-chat
MODEL_PRIORITY=anthropic/claude-sonnet-4.6,openai/gpt-5.3-chat,google/gemini-3-flash-preview
DEFAULT_MODEL=anthropic/claude-sonnet-4.6

# MongoDB Configuration
MONGODB_URI=
DATABASE_NAME=Product_Database

# Flask Configuration
FLASK_SECRET_KEY=
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Vision Model Path (set to src/vision/model or Render disk path)
# Can be a directory OR a specific .h5 file path. If a file path is provided,
# the app will still scan that directory for all *_good_bad_classifier.h5 models.
VISION_MODEL_PATH=src/vision/model/AirChef_Fryo_good_bad_classifier.h5

# Excel Export Directory
EXPORT_PATH=exports

# Upload configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Deployment runtime (Railway/Render)
PYTHON_VERSION=3.11.9
NIXPACKS_PYTHON_VERSION=3.11.9
